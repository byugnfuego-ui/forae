---
const { title, activePage = "" } = Astro.props;
---
<!DOCTYPE html>
<html lang="mn">
<head>
  <meta charset="UTF-8" />
  <title>{title}</title>
  <style is:global>
    :root { --paper: #ffffff; --ink: #161616; --graphite: #7a7a75; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: var(--paper); color: var(--ink); font-family: sans-serif; display: flex; flex-direction: column; min-height: 100vh; }
    .header-inner { display: flex; justify-content: space-between; padding: 20px 32px; }
    nav.primary { display: flex; gap: 32px; font-size: 12px; }
    nav.primary a.active { color: var(--graphite); font-weight: 600; }
    main { padding: 48px 32px; flex: 1; }
  </style>
</head>
<body>
  <header>
    <div class="header-inner">
      <a class="logo" href="/">forae architects</a>
      <nav class="primary">
        <a href="/practice" class={activePage === 'practice' ? 'active' : ''}>practice</a>
        <a href="/contact" class={activePage === 'contact' ? 'active' : ''}>contact</a>
        <a href="/news" class={activePage === 'news' ? 'active' : ''}>news</a>
        <a href="/reference" class={activePage === 'reference' ? 'active' : ''}>reference</a>
      </nav>
    </div>
  </header>

  <!-- БУСАД ХУУДАСНЫ ТЕКСТ ЭНД ОРЖ ИРНЭ -->
  <slot /> 

  <footer>
    <p style="text-align:center; padding: 24px;">© 2026 forae architects</p>
  </footer>
</body>
</html>
