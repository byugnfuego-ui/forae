<!DOCTYPE html>
<html lang="mn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>contact — FORAE ARCHITECTS</title>
<link rel="preconnect" href="https://googleapis.com">
<link rel="preconnect" href="https://gstatic.com" crossorigin>
<link href="https://googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#ffffff;
    --ink:#161616;
    --graphite:#7a7a75;
    --hairline:#e6e5e0;
    --accent:#2f6b52;
    --sans:"Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:var(--sans);
    -webkit-font-smoothing:antialiased;
    -moz-osx-font-smoothing: grayscale;
    display:flex;
    flex-direction:column;
    min-height:100vh;
    letter-spacing: -0.01em;
  }
  main{flex:1 0 auto; margin:0 auto; width:100%; max-width:760px;}
  a{color:inherit; text-decoration:none;}

  .header-inner{display:flex; align-items:center; justify-content:space-between; padding:20px 32px; gap:24px;}
  .logo{font-size:16px; font-weight:500; letter-spacing:0.02em; text-transform:lowercase;}
  nav.primary{display:flex; gap:32px; font-size:13px; letter-spacing:0.04em; font-weight:400; text-transform:lowercase;}
  nav.primary a.active{color:var(--ink);}
  nav.primary a:not(.active){color:var(--graphite);}
  nav.primary a:hover{color:var(--ink);}

  .page-wrap{padding:48px 32px 0;}
  h1.page-title{font-size:13px; font-weight:500; letter-spacing:0.05em; text-transform:uppercase; color:var(--graphite); margin-bottom:40px;}

  .contact-block{margin-bottom:28px;}
  .contact-block p{font-size:14px; line-height:1.75; color:var(--ink);}
  .contact-block p.sub{color:var(--graphite);}
  .contact-block a.link{text-decoration:underline; text-underline-offset:3px;}
  .contact-block a.link:hover{color:var(--graphite);}
  .contact-block h2{
    font-size:13px; font-weight:500; margin-bottom:8px;
  }

  .map-wrap{margin:40px 0; border:1px solid var(--hairline); border-radius:2px; padding:24px 8px;}
  .map-wrap svg{width:100%; height:auto; display:block;}

  .social-row{display:flex; gap:24px; margin-top:8px;}

  footer{margin-top:80px; padding:24px 32px 32px; text-align:center;}
  .copyright{font-size:12px; color:var(--graphite);}

  @media (max-width:560px){
    .header-inner{padding:14px 18px; flex-direction: column; align-items: flex-start; gap: 12px;}
    nav.primary{gap: 16px;}
    .page-wrap{padding:24px 18px 0;}
  }
</style>
</head>
<body>

<header>
  <div class="header-inner">
    <a class="logo" href="/">forae architects</a>
    <nav class="primary">
      <a href="/practice">practice</a>
      <a class="active" href="/contact">contact</a>
      <a href="/news">news</a>
      <a href="/reference">reference</a>
    </nav>
  </div>
</header>

<main>
  <div class="page-wrap">
    <h1 class="page-title">Contact</h1>

    <div class="contact-block">
      <h2>Хаяг</h2>
      <p>Улаанбаатар хот, Сүхбаатар дүүрэг, 1-р хороо</p>
     
    </div>

    <div class="contact-block">
      <h2>Холбогдох</h2>
      <p>+976 9810 5421</p>
      <p><a class="link" href="mailto:info@forae.net">info@forae.net</a></p>
    
    </div>

  
    </div>

    <div class="contact-block">
      <div class="social-row">
         <a class="link" href="https://www.instagram.com/forae_architects/" target="_blank" rel="noopener noreferrer">instagram</a>
      
      </div>
    </div>
  </div>
</main>

<footer>
  <p class="copyright">© 2026 forae architects</p>
</footer>

</body>
</html>
