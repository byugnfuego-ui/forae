---
import Layout from '../layouts/Layout.astro';
---

<Layout title="News — FORAE ARCHITECTS" activePage="news">
  <style>
    main { width: 100%; padding: 48px 32px 0; }
    .news-container { max-width: 900px; margin-top: 24px; }
    .news-item { font-size: 14px; line-height: 1.7; margin-bottom: 32px; color: var(--ink); font-weight: 400; }
    .news-date { display: inline; font-weight: 400; margin-right: 4px; }
    .mark { background-color: transparent; transition: background-color 0.2s ease; padding: 0 2px; }
    .news-item a:hover .mark { background-color: var(--highlight); }
    .news-item a:hover { color: #000; }

    @media (max-width: 560px) {
      main { padding: 24px 18px 0; }
      .news-item { font-size: 13px; line-height: 1.6; }
    }
  </style>

  <main>
    <div class="news-container">
      <div class="news-item">
        <span class="news-date">2026.06 _</span> 
        <a href="#">
          Францад хэвлэгддэг хараат бус соёлын Cahier de Seoul сэтгүүлд 
          <span class="mark">"forae architects: Орон сууцыг дахин төлөвлөх нь _ Наранбаатарын орон сууцны төслүүд"</span> 
          гэсэн нийтлэл хэвлэгдэн гарлаа. An article titled 'forae architects: Reconfiguring the House _ Residential Projects by Naranbaatar' was published in Cahier de Seoul, an independent cultural magazine published in France.
        </a>
      </div>
    </div>
  </main>
</Layout>
