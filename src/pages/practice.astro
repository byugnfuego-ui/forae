import Layout from '../layouts/Layout.astro';
---

<!-- 2. Хуудасныхаа кодыг Layout таг дотор боож бичнэ -->
<Layout title="Practice — FORAE ARCHITECTS" activePage="practice">
  <main>
    <h1 style="font-size: 11px; text-transform: uppercase; color: #7a7a75; margin-bottom: 24px;">About the Practice</h1>
    <p style="font-size: 16px; line-height: 1.6; max-width: 680px;">
      FORAE ARCHITECTS нь орчин үеийн архитектур, хот төлөвлөлтийн чиглэлээр үйл ажиллагаа явуулдаг бүтээлч студи юм. Бид барилга байгууламжийг зөвхөн орон зай төдийгүй, байгаль орчин, хүмүүсийн амьдралын хэв маягтай уусах уран бүтээл гэж хардаг.
    </p>
  </main>
</Layout>
